# Public application URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Linqo
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# Supabase — use the publishable key client-side; never expose secret/service-role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional server-only payment provider settings.
PAYMENT_DEFAULT_PROVIDER=unavailable
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_WEBHOOK_SECRET=

# Security / operations
RATE_LIMIT_SALT=replace-with-a-long-random-string
ADMIN_AUDIT_RETENTION_DAYS=365

# Development-only seed guard
ALLOW_DEMO_SEED=false
